+.baul-costo{margin:0;padding:10px 12px;border-radius:12px;background:#fff8e6;border:1px solid #f4dfa6;font-size:13px;color:#6b4e00}
+.baul-msg{border:1px solid var(--line,#e3e8ef);border-radius:14px;padding:10px 12px;background:#fff}
+.baul-msg>b{display:block;font-size:13.5px;margin-bottom:6px}
+.baul-msg pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere;font:500 13px/1.45 inherit;color:#334155}
+.baul-acc-pri{display:grid;grid-template-columns:1fr;gap:8px}
+.baul-acc-pri .se-btn{min-height:46px;font-weight:800}
+.baul-enviar{background:#1a8a5a!important;border-color:#1a8a5a!important;color:#fff!important}
+.baul-volver{align-self:flex-start;min-height:44px}
+/* R192 · Sala de Juntas: detalle con la sala 3D real, participantes con avatar, Mi avatar y escenarios */
+.sj-m-esc{margin:0;border-radius:16px;overflow:hidden;border:1px solid var(--line,#e3e8ef);background:#fff}
+.sj-m-esc img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
+.sj-m-esc figcaption{padding:6px 10px;font-size:12px;color:var(--muted,#64748b)}
+.sj-m-parts{display:flex;flex-wrap:wrap;gap:12px}
+.sj-m-part{display:grid;justify-items:center;gap:4px;min-width:56px}
+.sj-m-av{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;overflow:hidden;background:#fff;border:2px solid var(--c,#475569);color:var(--c,#475569);font-weight:800;box-shadow:0 3px 0 #e6ecf2}
+.sj-m-av img{width:100%;height:100%;object-fit:cover}
+.sj-m-espera{margin:0;padding:8px 10px;border-radius:12px;background:#fff8e6;border:1px solid #f4dfa6;font-weight:700;color:#6b4e00}
+.sj-m-entrar{min-height:48px;font-weight:800}
+.sj-m-mi-cab{display:flex;gap:12px;align-items:center}
+.sj-m-mi-cab span{display:grid;gap:2px}.sj-m-mi-cab small{color:var(--muted,#64748b)}
