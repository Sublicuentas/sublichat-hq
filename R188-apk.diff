+// R188 · Spotify Familiar en la APK (PDF «Sublichat 5 puntos», bloque 01). Se entra desde Más › Inventario (Más no cambia).
+// Mismas reglas que Web y bot, en el SERVIDOR (/api/inventario · _spotify-familias.js): 1 madre + 5 invitados, exclusividad,
+// mover/desvincular en transacción y con auditoría. Desvincular nunca borra al cliente. No se guarda contraseña de Spotify.
+import { authPost } from '../api.js';
+import { state, esc, ui, showToast } from './core.js';
+import { operatorIdentity } from '../data.js';
+
+export function canSpotify() { return ['sublicuentas', 'relojes', 'geisell'].includes(operatorIdentity(state.session?.role || '', state.session?.usuario || '')); }
+export function spState() { if (!state.spf) state.spf = { familias: null, abierta: '', busqueda: null, cargando: false, error: '' }; return state.spf; }
+export function spotifyEntradaHtml() { return canSpotify() ? `<button type="button" class="se-btn ghost spf-entrada" data-open-spotify>🎵 Spotify Familiar · familias e invitados</button>` : ''; }
+
+async function inv(accion, extra = {}) {
+  let r;
+  try { r = await authPost('/api/inventario', { accion, ...extra }); }
+  catch (e) { throw new Error(e?.data?.error || (Number(e?.status) === 403 ? 'Su usuario no tiene Spotify Familiar.' : e?.message || 'Sin conexión')); }
+  if (!r || r.ok === false) throw new Error(r?.error || 'No se pudo completar.');
+  return r;
+}
+export async function spCargar() {
+  const s = spState(); s.cargando = true; s.error = ''; ui.render();
+  try { s.familias = (await inv('spotifyFamilias')).familias || []; } catch (e) { s.error = e.message; s.familias = s.familias || []; }
+  s.cargando = false; if (state.subview === 'spotify-familias') ui.render();
+}
+// Para la ficha (CRM): ¿a qué familia pertenece este correo invitado?
+export async function spResolver(correo) { try { return (await inv('spotifyResolver', { correo })).familia || null; } catch (_) { return null; } }
+
+export function spotifyView() {
+  const s = spState();
+  if (!canSpotify()) return ui.subPage('Spotify Familiar', 'No disponible', '<div class="empty-state"><strong>Su usuario no tiene Spotify Familiar</strong></div>');
+  if (s.familias === null && !s.cargando) setTimeout(spCargar, 0);
+  const fam = (s.familias || []).find((f) => f.id === s.abierta);
+  const lista = (s.familias || []).map((f) => `<button type="button" class="se-item spf-fam ${f.id === s.abierta ? 'on' : ''}" data-spf-abrir="${esc(f.id)}"><div><b>${esc(f.codigo)} · ${esc(f.madreCorreo)}</b><small>Invitados ${f.ocupados}/${f.capacidad}</small></div></button>`).join('');
+  const otras = (s.familias || []).filter((f) => fam && f.id !== fam.id && f.libres > 0);
+  const detalle = fam ? `<article class="se-card"><b>${esc(fam.codigo)} · Cuenta madre</b><small>${esc(fam.madreCorreo)}</small><b>Invitados ${fam.ocupados}/${fam.capacidad}</b>
+    ${fam.miembros.filter((m) => m.estado === 'activo').map((m) => `<div class="spf-m"><span>${esc(m.correo)}${m.clienteNombre ? ` · ${esc(m.clienteNombre)}` : ''} · <b class="ok">Vinculada</b></span>
+      ${otras.length ? `<select class="se-input" data-spf-mover="${esc(m.correo)}"><option value="">Mover a…</option>${otras.map((o) => `<option value="${esc(o.id)}">${esc(o.codigo)} (${o.ocupados}/${o.capacidad})</option>`).join('')}</select>` : ''}
+      <button type="button" class="se-btn ghost" data-spf-desv="${esc(m.correo)}">Desvincular</button></div>`).join('')}
+    ${Array.from({ length: fam.libres }).map(() => '<small>+ Espacio disponible</small>').join('')}
