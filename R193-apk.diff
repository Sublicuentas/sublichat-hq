+test('J01/J02: «Entrar en la APK» abre la antesala y la sala 3D en una vista INTERNA (sin Chrome ni URL externa)', async () => {
+  const { app, llamadas, abiertos } = await abrirSala();
+  try {
+    const t = app.$('.se-wrap').textContent;
+    assert.match(t, /Mi avatar · Escenarios/); assert.match(t, /Acciones según permisos/); assert.match(t, /Programar reunión/);
+    await app.click('[data-sj-ver="reuEnCurso01"]', 150);
+    await app.click('[data-sj-interna="antesala"][data-id="reuEnCurso01"]', 200);
+    assert.ok(app.$('#sjApk #screen-sala-juntas.active #rbac-sala-juntas'), 'contenedor interno de la sala');
+    assert.deepEqual(llamadas[0], ['abrir', 'antesala', 'reuEnCurso01']);
+    assert.ok(app.w.document.documentElement.classList.contains('sj-apk-on'));
+    assert.equal(abiertos.length, 0); assert.equal((app.w.__intents || []).length, 0, 'no ACTION_VIEW');
+    // la sala usa la sesión de la APK (sin segundo login) y se identifica como android
+    const r = await app.w.SalaJuntasConfig.post({ accion: 'antesala', id: 'reuEnCurso01' });
+    assert.equal(r.eco.origen, 'android'); assert.equal(r.eco.accion, 'antesala');
+    assert.equal(app.w.SalaJuntasConfig.embebida, true);
+    // J11: al volver se libera la sala (micrófono/LiveKit/3D) y se quita la vista
+    await app.click('[data-sj-apk-cerrar]', 150);
+    assert.deepEqual(llamadas.at(-1), ['cerrar']); assert.equal(app.$('#sjApk'), null);
+    assert.equal(app.w.document.documentElement.classList.contains('sj-apk-on'), false);
+  } finally { app.close(); }
+});
