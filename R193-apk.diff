+export function hojaProductos(wb, mes) {
+  if (!mes || !Array.isArray(mes.cobrosPorProducto)) return null;
+  const ws = wb.addWorksheet('Cobros por producto');
+  ws.columns = [{ header: 'Producto', key: 'p', width: 34 }, { header: 'Pagos', key: 'n', width: 10 }, { header: 'Cobrado (L)', key: 'm', width: 16 }, { header: 'Etiquetas originales', key: 'a', width: 60 }];
+  for (const x of mes.cobrosPorProducto) ws.addRow({ p: x.plataforma, n: x.pagos || 0, m: Number(x.monto) || 0, a: (x.alias || []).join(' · ') });
+  const P = mes.pendienteClasificar || {};
+  if (P.centavos) ws.addRow({ p: 'Pendiente de clasificar', n: P.pagos || 0, m: Number(P.monto) || 0, a: 'Fuera del ranking; dentro del total' });
+  ws.addRow({}); ws.addRow({ p: 'TOTAL cobrado del mes', m: Number(mes.ingresos) || 0, a: mes.conciliacion?.productosMasPendienteIgualIngresos === false ? 'NO CUADRA: revisar' : 'Productos + pendiente = cobrado' });
+  ws.getColumn('m').numFmt = '#,##0.00'; ws.getRow(1).font = { bold: true };
+  if (Array.isArray(P.detalle) && P.detalle.length) {
