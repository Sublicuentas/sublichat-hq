+// R189 · APK: Más › Sala de Juntas = la MISMA sala de Sublichat Web (mismo servidor y misma base). Datos ficticios.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import { bootApp } from './helpers/ui-harness.mjs';
+import { roleModules } from '../src/data.js';
+import { MAS_MODULES } from '../src/screens.js';
+
+const AHORA = Date.UTC(2026, 9, 4, 18, 0, 0);
+const PANEL = { ok: true, yo: { id: 'naara', nombre: 'Naara', anfitriona: true }, permisos: { crear: true, moderar: true }, tiempoReal: true,
+  fundadoras: [{ id: 'naara', nombre: 'Naara' }, { id: 'libni', nombre: 'Libni' }, { id: 'geisell', nombre: 'Geisell' }],
+  reuniones: [
+    { id: 'reuPrueba01', titulo: 'Junta de prueba', agenda: ['Ventas'], inicioMs: AHORA + 3600e3, fecha: '04/10/2026', hora: '1:00 p. m.', duracionMin: 45, estado: 'programada', participantes: ['naara', 'libni', 'geisell'],
+      invitaciones: { libni: { estado: 'aceptada' } }, avisos: { enviado: 2, pendiente: 0, fallido: 1, fallas: [{ usuario: 'geisell', tipo: 'h1', error: 'bot bloqueado' }] } },
+    { id: 'reuPasada01', titulo: 'Cierre de septiembre', inicioMs: AHORA - 30 * 864e5, fecha: '04/09/2026', hora: '9:00 a. m.', estado: 'finalizada', participantes: ['naara', 'libni'], invitaciones: {} },
+  ] };
+
+test('Más: solo se AGREGA Sala de Juntas (fundadoras); un rol desconocido no la ve; navbar intacto', () => {
+  assert.ok(MAS_MODULES['sala-juntas']?.svg);
+  for (const [r, u] of [['sublicuentas', 'sublicuentas'], ['relojes', 'libni'], ['geisell', 'geisell']]) assert.ok(roleModules(r, u).more.includes('sala-juntas'), u);
+  assert.equal(roleModules('otro', 'otro').more.includes('sala-juntas'), false);
+  assert.deepEqual(roleModules('geisell', 'geisell').tabs, ['inicio', 'clientes', 'tickets', 'mas']);
+});
+
+test('sin tokens en la APK: entra a la misma sala web (/?sala=id) en el navegador; no pide micrófono ni cámara', () => {
+  const src = fs.readFileSync(new URL('../src/app/sala-juntas.js', import.meta.url), 'utf8');
+  assert.match(src, /\$\{API_BASE\}\/\?sala=\$\{encodeURIComponent\(id\)\}/);
+  const codigo = src.split('\n').filter((l) => !l.trim().startsWith('//')).join('\n');
+  assert.doesNotMatch(codigo, /token_tiempo_real|LIVEKIT|getUserMedia|livekit/i);
+  assert.match(src, /authPost\('\/api\/sala-juntas'/);
+});
+
+test('lista próximas y concluidas con estado; detalle con invitaciones, avisos fallidos; RSVP por el servidor; entrar pide confirmación', async () => {
+  const abiertos = [];
+  const app = await bootApp({ role: 'sublicuentas', fetchExtra: async (path, body) => {
+    if (path !== '/api/sala-juntas') return undefined;
+    if (body.accion === 'panel') return PANEL;
+    if (body.accion === 'actas') return { ok: true, actas: [{ reunionId: 'reuPrueba01', acuerdos: 3, pendientes: 1 }] };
+    if (body.accion === 'rsvp') return { ok: true, id: body.id, estado: body.respuesta };
+    return { ok: true };
+  } });
+  try {
+    app.w.open = (u) => abiertos.push(u);
+    await app.click('[data-tab="mas"]', 300);
+    await app.click('[data-open="sala-juntas"]', 400);
+    await app.waitFor(() => /Junta de prueba/.test(app.$('.se-wrap')?.textContent || ''));
+    const t = app.$('.se-wrap').textContent;
+    assert.match(t, /Programada/); assert.match(t, /Concluida/);
+    await app.click('[data-sj-ver="reuPrueba01"]', 150);
+    const d = app.$('.se-wrap').textContent;
+    assert.match(d, /Libni · Confirmó/); assert.match(d, /Geisell · Pendiente/); assert.match(d, /fallidos 1 \(Geisell: bot bloqueado\)/); assert.match(d, /Acuerdos:\s*3 · pendientes 1/);
+    await app.click('[data-sj-rsvp="aceptada"]', 300);
+    const r = app.bodies.find((b) => b?.accion === 'rsvp');
+    assert.deepEqual([r.id, r.respuesta, r.origen], ['reuPrueba01', 'aceptada', 'android']);
+    await app.waitFor(() => app.$('[data-sj-entrar="reuPrueba01"]'));
+    await app.click('[data-sj-entrar="reuPrueba01"]', 150);
+    assert.match(app.$('.se-wrap').textContent, /micrófono y la cámara solo se encienden cuando usted lo permite/);
+    assert.equal(abiertos.length, 0, 'no abre nada sin confirmar');
+  } finally { app.close(); }
+});
