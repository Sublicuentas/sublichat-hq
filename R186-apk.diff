+export async function guardarEnDescargas(filename, buffer, mime = XLSX_MIME) {
+  const { Capacitor, registerPlugin } = await import('@capacitor/core');
+  if (!Capacitor.isNativePlatform()) {
+    const url = URL.createObjectURL(new Blob([buffer], { type: mime }));
+    const a = document.createElement('a'); a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 4000);
+    return { mode: 'browser', guardadoEn: 'Descargas' };
+  }
+  const plugin = registerPlugin('SubliWidget');
+  try {
+    const r = await plugin.guardarDescarga({ nombre: filename, mime, data: bufferToBase64(buffer) });
+    return { mode: 'native', uri: r?.uri || '', guardadoEn: `${r?.carpeta || 'Descargas'}/${r?.nombre || filename}`, bytes: r?.bytes || 0 };
+  } catch (e) {
+    if (/not implemented|no implementado|UNIMPLEMENTED/i.test(String(e?.message || e?.code || ''))) return saveAndShareXlsx(filename, buffer);
+    throw e;
+  }
+}
