+.baul-acc .se-btn,.baul-acc-pri .se-btn,.baul-volver{box-shadow:0 3px 0 #dbe3ec,0 6px 12px rgba(20,40,70,.08);transition:transform .12s ease,box-shadow .12s ease}
+.baul-acc .se-btn:active,.baul-acc-pri .se-btn:active,.baul-volver:active{transform:translateY(2px);box-shadow:0 1px 0 #dbe3ec,0 3px 6px rgba(20,40,70,.08)}
+.baul-enviar{box-shadow:0 3px 0 #116b44,0 6px 12px rgba(17,107,68,.22)!important}
+.baul-enviar:active{box-shadow:0 1px 0 #116b44,0 3px 6px rgba(17,107,68,.2)!important}
+.baul-msg{box-shadow:inset 0 1px 2px rgba(20,40,70,.06)}
+@media (prefers-reduced-motion:reduce){.baul-plat,.baul-disp,.baul-acc .se-btn,.baul-acc-pri .se-btn,.baul-volver{transition:none}}
+/* R194 · La Sala abre directo SubliStudio 3D: barra mínima para volver a Más */
+.sj-apk-top{border-bottom:0;margin-bottom:4px}
